# NigraniAI dashboard: server settings for consent_service/server.py
# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# Keep comments on their own lines: text after a value is read as part of the value.
# Ask the project lead for the real values over a private channel.

# ---- The client this copy belongs to
# shown in the dashboard, notices, invoices and AI instructions
CLIENT_NAME=ShopSmart
CLIENT_ID=shopsmart

# ---- NigraniAI Supabase project: dashboard sign-in and the client's logs (schema "guardrail")
SUPABASE_URL=https://<project-ref>.supabase.co
# server only: staff accounts (Auth admin API)
SUPABASE_SERVICE_KEY=<service role key>
# verifies sign-ins; logs are read with the user's own login
GUARDRAIL_ANON_KEY=<anon key>
SUPABASE_DB_SCHEMA=guardrail

# ---- The client's own database (read-only: every request is a GET)
SHOP_SUPABASE_URL=https://<shop-project-ref>.supabase.co
SHOP_SUPABASE_SERVICE_KEY=<service role key>

# ---- Local service
CONSENT_PORT=8091
# the address you open the dashboard on
CONSENT_ALLOWED_ORIGINS=http://localhost:8090
# the client's root admin account
ROOT_EMAIL=root@example.com

# ---- AI assistant (Groq by default; an xAI key also works)
GROK_API_KEY=<groq key>
# optional: another OpenAI-compatible endpoint
# GROK_BASE_URL=
# optional: defaults to the built-in model
# GROK_MODEL=
# optional: how much dashboard context the AI gets
# GROK_CONTEXT_CHARS=10000

# ---- Payments (Razorpay test keys while developing)
RAZORPAY_KEY_ID=rzp_test_<id>
RAZORPAY_KEY_SECRET=<secret>
# RAZORPAY_WEBHOOK_SECRET=<webhook secret>

# ---- PII detection language model (optional; only if consent_service/.pii-venv exists)
# en_core_web_md uses less memory
# PII_NER_MODEL=en_core_web_lg

# ---- Optional central reporting (leave empty during development)
# CENTRAL_URL=
# CENTRAL_ANON_KEY=
# CENTRAL_CLIENT_KEY=
# CENTRAL_REPORT_MINUTES=15
